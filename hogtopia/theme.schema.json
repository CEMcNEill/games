{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "prospect",
    "title",
    "tagline",
    "palette",
    "products",
    "music",
    "text",
    "game"
  ],
  "additionalProperties": false,
  "properties": {
    "prospect": {
      "type": "object",
      "required": [
        "name",
        "short"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "description": "Company name as they write it"
        },
        "short": {
          "type": "string",
          "minLength": 1,
          "maxLength": 14,
          "description": "Short name for tight spots"
        },
        "domain": {
          "type": "string",
          "maxLength": 60
        }
      }
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 30,
      "description": "Game title shown big on the title screen"
    },
    "tagline": {
      "type": "string",
      "minLength": 3,
      "maxLength": 48,
      "description": "One line under the title, e.g. 'Made for Acme Rockets by PostHog'"
    },
    "palette": {
      "type": "object",
      "required": [
        "primary",
        "secondary",
        "accent"
      ],
      "additionalProperties": false,
      "properties": {
        "primary": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "description": "Main brand colour"
        },
        "secondary": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "description": "Second brand colour; the darker one becomes the background"
        },
        "accent": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "description": "Highlight colour for selections and titles"
        }
      }
    },
    "products": {
      "type": "array",
      "minItems": 4,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "product_analytics",
          "session_replay",
          "feature_flags",
          "experiments",
          "error_tracking",
          "surveys",
          "data_warehouse"
        ]
      },
      "description": "PostHog products featured in the game, most relevant first"
    },
    "music": {
      "type": "object",
      "required": [
        "mood"
      ],
      "additionalProperties": false,
      "properties": {
        "mood": {
          "type": "string",
          "minLength": 3,
          "maxLength": 80,
          "description": "Mood words for the chiptune generator"
        },
        "bpm": {
          "type": "integer",
          "minimum": 80,
          "maximum": 180
        }
      }
    },
    "text": {
      "type": "object",
      "required": [
        "win",
        "lose",
        "credits"
      ],
      "additionalProperties": false,
      "properties": {
        "win": {
          "type": "string",
          "minLength": 3,
          "maxLength": 110
        },
        "lose": {
          "type": "string",
          "minLength": 3,
          "maxLength": 110
        },
        "credits": {
          "type": "string",
          "minLength": 3,
          "maxLength": 80
        }
      }
    },
    "game": {
      "type": "object",
      "required": [
        "difficulty",
        "biome",
        "faction",
        "cities",
        "rival",
        "tips"
      ],
      "additionalProperties": false,
      "properties": {
        "difficulty": {
          "type": "string",
          "enum": [
            "easy",
            "normal",
            "hard"
          ],
          "description": "easy for execs and non-gamers, normal for most, hard only for strategy fans"
        },
        "biome": {
          "type": "string",
          "enum": [
            "meadow",
            "desert",
            "tundra",
            "circuit"
          ],
          "description": "Map look that suits their world (circuit = techy/datacenter)"
        },
        "faction": {
          "type": "object",
          "required": [
            "name",
            "capital"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 2,
              "maxLength": 20,
              "description": "The player's side, usually the prospect or its team"
            },
            "capital": {
              "type": "string",
              "minLength": 2,
              "maxLength": 14,
              "description": "Their HQ city name"
            }
          }
        },
        "cities": {
          "type": "array",
          "minItems": 4,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 14
          },
          "description": "Names for villages the player captures: places, teams or products from their world"
        },
        "rival": {
          "type": "object",
          "required": [
            "name",
            "taunts",
            "sprite_prompt"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 3,
              "maxLength": 22,
              "description": "Their biggest generic problem, never a competitor"
            },
            "capital": {
              "type": "string",
              "maxLength": 14
            },
            "taunts": {
              "type": "array",
              "minItems": 3,
              "maxItems": 4,
              "items": {
                "type": "string",
                "minLength": 3,
                "maxLength": 54
              }
            },
            "defeat": {
              "type": "string",
              "maxLength": 70,
              "description": "Line when its capital falls"
            },
            "sprite_prompt": {
              "type": "string",
              "minLength": 10,
              "maxLength": 200
            }
          }
        },
        "tips": {
          "type": "array",
          "minItems": 3,
          "maxItems": 5,
          "items": {
            "type": "string",
            "minLength": 5,
            "maxLength": 90
          },
          "description": "Advisor tips from the PostHog hedgehog, tying strategy to their world"
        },
        "tech_lines": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "maxLength": 48
          },
          "description": "Optional one-liner per product id, shown in the research menu"
        },
        "units": {
          "type": "object",
          "additionalProperties": false,
          "description": "Optional flavour names for the player's units",
          "properties": {
            "scout": {
              "type": "string",
              "minLength": 2,
              "maxLength": 12
            },
            "warrior": {
              "type": "string",
              "minLength": 2,
              "maxLength": 12
            },
            "archer": {
              "type": "string",
              "minLength": 2,
              "maxLength": 12
            },
            "defender": {
              "type": "string",
              "minLength": 2,
              "maxLength": 12
            },
            "catcher": {
              "type": "string",
              "minLength": 2,
              "maxLength": 12
            }
          }
        },
        "hq_prompt": {
          "type": "string",
          "maxLength": 200,
          "description": "Their HQ building, one subject"
        }
      }
    }
  },
  "$id": "https://games.local/kits/hogtopia/theme.schema.json",
  "title": "Hogtopia theme"
}

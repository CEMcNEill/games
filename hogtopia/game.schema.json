{
  "type": "object",
  "required": ["difficulty", "biome", "faction", "cities", "rival", "tips"],
  "additionalProperties": false,
  "properties": {
    "difficulty": { "type": "string", "enum": ["easy", "normal", "hard"], "description": "easy for execs and non-gamers, normal for most, hard only for strategy fans" },
    "biome": { "type": "string", "enum": ["meadow", "desert", "tundra", "circuit"], "description": "Map look that suits their world (circuit = techy/datacenter)" },
    "faction": {
      "type": "object", "required": ["name", "capital"], "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 2, "maxLength": 20, "description": "The player's side, usually the prospect or its team" },
        "capital": { "type": "string", "minLength": 2, "maxLength": 14, "description": "Their HQ city name" }
      }
    },
    "cities": {
      "type": "array", "minItems": 4, "maxItems": 6, "uniqueItems": true,
      "items": { "type": "string", "minLength": 2, "maxLength": 14 },
      "description": "Names for villages the player captures: places, teams or products from their world"
    },
    "rival": {
      "type": "object", "required": ["name", "taunts", "sprite_prompt"], "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 3, "maxLength": 22, "description": "Their biggest generic problem, never a competitor" },
        "capital": { "type": "string", "maxLength": 14 },
        "taunts": { "type": "array", "minItems": 3, "maxItems": 4, "items": { "type": "string", "minLength": 3, "maxLength": 54 } },
        "defeat": { "type": "string", "maxLength": 70, "description": "Line when its capital falls" },
        "sprite_prompt": { "type": "string", "minLength": 10, "maxLength": 200 }
      }
    },
    "tips": {
      "type": "array", "minItems": 3, "maxItems": 5,
      "items": { "type": "string", "minLength": 5, "maxLength": 90 },
      "description": "Advisor tips from the PostHog hedgehog, tying strategy to their world"
    },
    "tech_lines": {
      "type": "object", "additionalProperties": { "type": "string", "maxLength": 48 },
      "description": "Optional one-liner per product id, shown in the research menu"
    },
    "units": {
      "type": "object", "additionalProperties": false,
      "description": "Optional flavour names for the player's units",
      "properties": {
        "scout": { "type": "string", "minLength": 2, "maxLength": 12 },
        "warrior": { "type": "string", "minLength": 2, "maxLength": 12 },
        "archer": { "type": "string", "minLength": 2, "maxLength": 12 },
        "defender": { "type": "string", "minLength": 2, "maxLength": 12 },
        "catcher": { "type": "string", "minLength": 2, "maxLength": 12 }
      }
    },
    "hq_prompt": { "type": "string", "maxLength": 200, "description": "Their HQ building, one subject" }
  }
}

{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noImplicitAny": false,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": { "@shared/*": ["shared/src/*"] },
    "types": []
  },
  "include": ["shared/src/**/*.ts", "*/src/**/*.ts"],
  "exclude": ["mp-server", "node_modules"]
}

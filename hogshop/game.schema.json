{
  "type": "object",
  "required": ["difficulty", "store", "manager", "items", "hot_item", "customers", "docks", "days", "jam", "rush"],
  "additionalProperties": false,
  "properties": {
    "difficulty": {
      "type": "string",
      "enum": ["easy", "normal", "hard"],
      "description": "easy for execs and non-gamers, normal for most, hard for gamer champions"
    },
    "store": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 2, "maxLength": 20, "description": "The shop's name as customers know it, e.g. 'HogShop'" },
        "sprite_prompt": { "type": "string", "maxLength": 160, "description": "The back-room floor seen from above, for a 32x32 tile" }
      }
    },
    "manager": {
      "type": "object",
      "required": ["name", "title", "sprite_prompt"],
      "additionalProperties": false,
      "description": "Who briefs the player every morning. Generic unless the brief names someone.",
      "properties": {
        "name": { "type": "string", "minLength": 2, "maxLength": 14 },
        "title": { "type": "string", "minLength": 2, "maxLength": 20 },
        "sprite_prompt": { "type": "string", "minLength": 10, "maxLength": 160, "description": "One person or animal, head and shoulders" }
      }
    },
    "items": {
      "type": "array",
      "minItems": 6,
      "maxItems": 8,
      "description": "What the shop sells: the things that ride the conveyor belts. Short names, easy to tell apart at 16x16.",
      "items": {
        "type": "object",
        "required": ["name", "sprite_prompt"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 2, "maxLength": 12 },
          "sprite_prompt": { "type": "string", "minLength": 6, "maxLength": 160, "description": "One object, clear silhouette and main colour" },
          "fragile": { "type": "boolean", "description": "Needs bubble wrap from day 3 (mugs, glass, screens). Mark 2-3 items." }
        }
      }
    },
    "hot_item": {
      "type": "object",
      "required": ["name", "sprite_prompt"],
      "additionalProperties": false,
      "description": "The limited-stock bestseller that shows up on day 4: only a couple ever come down the belt",
      "properties": {
        "name": { "type": "string", "minLength": 2, "maxLength": 14 },
        "sprite_prompt": { "type": "string", "minLength": 6, "maxLength": 160 }
      }
    },
    "customers": {
      "type": "array",
      "minItems": 4,
      "maxItems": 8,
      "uniqueItems": true,
      "description": "First names on the order tickets (their kind of customer)",
      "items": { "type": "string", "minLength": 2, "maxLength": 10 }
    },
    "docks": {
      "type": "object",
      "required": ["standard", "express", "international"],
      "additionalProperties": false,
      "description": "Names on the three shipping doors",
      "properties": {
        "standard": { "type": "string", "minLength": 3, "maxLength": 9 },
        "express": { "type": "string", "minLength": 3, "maxLength": 9 },
        "international": { "type": "string", "minLength": 3, "maxLength": 9 }
      }
    },
    "days": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "description": "The manager's morning line for each of the 5 days; tie each to one of their pains",
      "items": {
        "type": "object",
        "required": ["intro"],
        "additionalProperties": false,
        "properties": {
          "intro": { "type": "string", "minLength": 10, "maxLength": 110 }
        }
      }
    },
    "jam": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "description": "Day 4's recurring problem: a belt stops until the player pulls its lever",
      "properties": {
        "name": { "type": "string", "minLength": 3, "maxLength": 16, "description": "e.g. 'BELT JAM', 'CHECKOUT BUG'" }
      }
    },
    "rush": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "description": "Day 5's surge of orders",
      "properties": {
        "name": { "type": "string", "minLength": 3, "maxLength": 16, "description": "e.g. 'FLASH SALE', 'BLACK FRIDAY'" }
      }
    }
  }
}

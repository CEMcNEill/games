{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "prospect",
    "title",
    "tagline",
    "palette",
    "products",
    "music",
    "text",
    "game"
  ],
  "additionalProperties": false,
  "properties": {
    "prospect": {
      "type": "object",
      "required": [
        "name",
        "short"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "description": "Company name as they write it"
        },
        "short": {
          "type": "string",
          "minLength": 1,
          "maxLength": 14,
          "description": "Short name for tight spots"
        },
        "domain": {
          "type": "string",
          "maxLength": 60
        }
      }
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 30,
      "description": "Game title shown big on the title screen"
    },
    "tagline": {
      "type": "string",
      "minLength": 3,
      "maxLength": 48,
      "description": "One line under the title, e.g. 'Made for Acme Rockets by PostHog'"
    },
    "palette": {
      "type": "object",
      "required": [
        "primary",
        "secondary",
        "accent"
      ],
      "additionalProperties": false,
      "properties": {
        "primary": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "description": "Main brand colour"
        },
        "secondary": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "description": "Second brand colour; the darker one becomes the background"
        },
        "accent": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "description": "Highlight colour for selections and titles"
        }
      }
    },
    "products": {
      "type": "array",
      "minItems": 3,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "session_replay",
          "feature_flags",
          "experiments",
          "error_tracking",
          "product_analytics",
          "surveys",
          "web_analytics",
          "data_warehouse"
        ]
      },
      "description": "PostHog products featured in the game, most relevant first"
    },
    "music": {
      "type": "object",
      "required": [
        "mood"
      ],
      "additionalProperties": false,
      "properties": {
        "mood": {
          "type": "string",
          "minLength": 3,
          "maxLength": 80,
          "description": "Mood words for the chiptune generator"
        },
        "bpm": {
          "type": "integer",
          "minimum": 80,
          "maximum": 180
        }
      }
    },
    "text": {
      "type": "object",
      "required": [
        "win",
        "lose",
        "credits"
      ],
      "additionalProperties": false,
      "properties": {
        "win": {
          "type": "string",
          "minLength": 3,
          "maxLength": 110
        },
        "lose": {
          "type": "string",
          "minLength": 3,
          "maxLength": 110
        },
        "credits": {
          "type": "string",
          "minLength": 3,
          "maxLength": 80
        }
      }
    },
    "game": {
      "type": "object",
      "required": [
        "difficulty",
        "intro",
        "rooms",
        "npcs",
        "enemies",
        "boss",
        "ending"
      ],
      "additionalProperties": false,
      "properties": {
        "difficulty": {
          "type": "string",
          "enum": [
            "easy",
            "normal",
            "hard"
          ],
          "description": "easy for execs and non-gamers, normal for most, hard for gamer champions"
        },
        "intro": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 90
          },
          "description": "Narration when the game starts, one box each"
        },
        "rooms": {
          "type": "array",
          "minItems": 3,
          "maxItems": 4,
          "description": "The office, walked left to right. 4 rooms = a longer game",
          "items": {
            "type": "object",
            "required": [
              "layout",
              "name",
              "description"
            ],
            "additionalProperties": false,
            "properties": {
              "layout": {
                "type": "string",
                "enum": [
                  "lobby",
                  "open_office",
                  "server_room",
                  "meeting_room",
                  "kitchen"
                ]
              },
              "name": {
                "type": "string",
                "minLength": 3,
                "maxLength": 22
              },
              "description": {
                "type": "string",
                "minLength": 3,
                "maxLength": 60
              }
            }
          }
        },
        "npcs": {
          "type": "array",
          "minItems": 3,
          "maxItems": 6,
          "items": {
            "type": "object",
            "required": [
              "name",
              "role",
              "room",
              "lines",
              "sprite_prompt"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 2,
                "maxLength": 14
              },
              "role": {
                "type": "string",
                "minLength": 3,
                "maxLength": 22
              },
              "room": {
                "type": "integer",
                "minimum": 0,
                "maximum": 3,
                "description": "Index into rooms"
              },
              "lines": {
                "type": "array",
                "minItems": 1,
                "maxItems": 3,
                "items": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 90
                }
              },
              "sprite_prompt": {
                "type": "string",
                "minLength": 10,
                "maxLength": 200
              }
            }
          }
        },
        "enemies": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": [
              "name",
              "pain",
              "intro",
              "talk",
              "solved_by",
              "solve_line",
              "patterns",
              "sprite_prompt"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 3,
                "maxLength": 18,
                "description": "Their problem as a monster name"
              },
              "pain": {
                "type": "string",
                "minLength": 3,
                "maxLength": 60,
                "description": "One line on the pain, in their words"
              },
              "intro": {
                "type": "string",
                "minLength": 3,
                "maxLength": 80,
                "description": "Battle opening line, e.g. 'Flaky Test blocks the way! It passed yesterday.'"
              },
              "talk": {
                "type": "array",
                "minItems": 2,
                "maxItems": 3,
                "items": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 90
                },
                "description": "What happens when you TALK, one per turn"
              },
              "solved_by": {
                "type": "string",
                "enum": [
                  "session_replay",
                  "feature_flags",
                  "experiments",
                  "error_tracking",
                  "product_analytics",
                  "surveys",
                  "web_analytics",
                  "data_warehouse"
                ],
                "description": "The PostHog product that solves this problem; must be in products"
              },
              "solve_line": {
                "type": "string",
                "minLength": 3,
                "maxLength": 90,
                "description": "What the product reveals or fixes, shown after 'You use <Product>!'"
              },
              "patterns": {
                "type": "array",
                "minItems": 1,
                "maxItems": 3,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "enum": [
                    "rain",
                    "sweep",
                    "spiral",
                    "bounce",
                    "aimed",
                    "wall",
                    "orbit",
                    "laser",
                    "thread",
                    "gems",
                    "stoplight",
                    "gravity",
                    "squeeze",
                    "burst"
                  ]
                },
                "description": "Bullet patterns for its turns, cycled"
              },
              "sprite_prompt": {
                "type": "string",
                "minLength": 10,
                "maxLength": 200
              }
            }
          }
        },
        "boss": {
          "type": "object",
          "required": [
            "name",
            "pain",
            "intro",
            "talk",
            "solved_by",
            "solve_line",
            "patterns",
            "sprite_prompt",
            "taunt"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 3,
              "maxLength": 22,
              "description": "Their problem as a monster name"
            },
            "pain": {
              "type": "string",
              "minLength": 3,
              "maxLength": 60,
              "description": "One line on the pain, in their words"
            },
            "intro": {
              "type": "string",
              "minLength": 3,
              "maxLength": 80,
              "description": "Battle opening line, e.g. 'Flaky Test blocks the way! It passed yesterday.'"
            },
            "talk": {
              "type": "array",
              "minItems": 2,
              "maxItems": 3,
              "items": {
                "type": "string",
                "minLength": 3,
                "maxLength": 90
              },
              "description": "What happens when you TALK, one per turn"
            },
            "solved_by": {
              "type": "string",
              "enum": [
                "session_replay",
                "feature_flags",
                "experiments",
                "error_tracking",
                "product_analytics",
                "surveys",
                "web_analytics",
                "data_warehouse"
              ],
              "description": "The PostHog product that solves this problem; must be in products"
            },
            "solve_line": {
              "type": "string",
              "minLength": 3,
              "maxLength": 90,
              "description": "What the product reveals or fixes, shown after 'You use <Product>!'"
            },
            "patterns": {
              "type": "array",
              "minItems": 1,
              "maxItems": 3,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "rain",
                  "sweep",
                  "spiral",
                  "bounce",
                  "aimed",
                  "wall",
                  "orbit",
                  "laser",
                  "thread",
                  "gems",
                  "stoplight",
                  "gravity",
                  "squeeze",
                  "burst"
                ]
              },
              "description": "Bullet patterns for its turns, cycled"
            },
            "sprite_prompt": {
              "type": "string",
              "minLength": 10,
              "maxLength": 200
            },
            "taunt": {
              "type": "string",
              "minLength": 3,
              "maxLength": 70,
              "description": "Said on the map before the final battle"
            }
          }
        },
        "ending": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 90
          },
          "description": "Narration after the boss, before the end screen"
        },
        "ending_pacifist": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 90
          },
          "description": "Optional. Narration after sparing all four problems (the kind route); falls back to ending"
        },
        "ending_bugfix": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 90
          },
          "description": "Optional. Narration after defeating all four problems the hard way; falls back to ending"
        }
      }
    }
  },
  "$id": "https://games.local/kits/hog-quest/theme.schema.json",
  "title": "Hog Quest theme"
}
